  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 574217088}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 674883bb27b283240b9570dcd9db6518, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PantallaUI
  musica: {fileID: 8300000, guid: f502cda91cccd7d4991c8ca224ea80fa, type: 3}
  volumenMusica: 0.1
  musicaEnBucle: 1
  segundosEntradaMusica: 3
  sonidoHover: {fileID: 8300000, guid: 9994bb1c1d1c1114e9ebf10a5d9f8f8b, type: 3}
  sonidoClick: {fileID: 8300000, guid: 99771ae3e7c18b54095d5b4e050fb100, type: 3}
  volumenBotones: 0.1
  escenaSiguiente: Game
  texto: {fileID: 1770782779}
  textoPagina: {fileID: 1106811242}
  textoBoton: {fileID: 545839978}
  paginas:
  - "<size=130%><b>EST\xC1S SOLO EN EL BOSQUE</b></size>\n\nTu auto qued\xF3 tirado
    en la ruta y la noche cay\xF3 hace horas.\n\nLa \xFAnica salida es la <color=#FFD54F>torre
    de radio</color> que se ve del otro lado del r\xEDo, pero el puente est\xE1 roto.\n\nTen\xE9s
    <color=#FFD54F>15 minutos</color>. Si se acaba el tiempo, no vas a salir de ac\xE1."
  - "<size=130%><b>QU\xC9 TEN\xC9S QUE HACER</b></size>\n\n<color=#FFD54F>1.</color>
    Junt\xE1 los <b>5 troncos y cuerdas</b> que hay por el bosque para reparar el
    puente.\n\n<color=#FFD54F>2.</color> Cruz\xE1 el puente y encontr\xE1 el <b>fusible</b>.\n\n<color=#FFD54F>3.</color>
    Lleg\xE1 a la torre y apret\xE1 <b>E</b> sobre el bot\xF3n de la radio para pedir
    ayuda."
  - "<size=130%><b>NO EST\xC1S SOLO</b></size>\n\nAlgo vive en este bosque. Patrulla
    de noche y si te ve, te persigue. Cada golpe te saca vida.\n\nSi te perd\xE9s
    de vista, te busca un rato y vuelve a patrullar. Escondete, apag\xE1 la linterna
    y no corras si no hace falta: <color=#FFD54F>los pasos se escuchan</color>.\n\nPero
    cuando termines el puente, <color=#FF5A4F>va a venir directo por vos</color>.
    Ya no se va a dar por vencido."
  - "<size=130%><b>CONTROLES</b></size>\n\n<color=#FFD54F>W A S D</color>  \u2014 
    moverte\n<color=#FFD54F>Shift</color>  \u2014  correr\n<color=#FFD54F>Espacio</color> 
    \u2014  saltar\n<color=#FFD54F>Mouse</color>  \u2014  mover la c\xE1mara\n<color=#FFD54F>Rueda
    del mouse</color>  \u2014  acercar o alejar la c\xE1mara\n<color=#FFD54F>F</color> 
    \u2014  prender o apagar la linterna\n<color=#FFD54F>E</color>  \u2014  agarrar,
    abrir y usar\n\nMucha suerte."
  caracteresPorSegundo: 45
  caracteresPorSonido: 2
  sonidosTecla:
  - {fileID: 8300000, guid: b32f2a6bc8ccb724a95b80057185de2c, type: 3}
  - {fileID: 8300000, guid: e898dde72ba08924da34500a6a8f70d4, type: 3}
  - {fileID: 8300000, guid: c89d29771910a0f468075d274cc6ce64, type: 3}
  volumenTecla: 0.5
  teclaSiguiente: 1
  teclaAlternativa: 2
  teclaSaltar: 60
